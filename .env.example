# Environment Configuration for Production Deployment

# Qdrant Cloud Vector Database Credentials
QDRANT_URL=https://bb03db18-09fc-41fb-a3d6-9a3fa3d0a360.eu-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=document_intelligence_chunks

# OpenRouter & Groq Model API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Model Settings
EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_MODEL=openai/gpt-4o-mini
ROUTER_MODEL=llama-3.1-8b-instant

# LangSmith Observability & Tracing Credentials
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=rag-observebility

